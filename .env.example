# PaperCreator configuration template.
# Copy to `.env` in the repo root (dev) or into
# <selected-workbench>\.papercreator\.env (installed).
# `.env` is gitignored. Never commit real keys.
# Every value here is optional - the app boots with no .env at all.

# ---------------------------------------------------------------- paths
# Normal folder selected as the portable workbench. The desktop launcher sets
# this automatically. All managed data is created in its .papercreator child.
# PAPERCREATOR_WORKBENCH=D:\ResearchWorkbench
# Legacy/headless/test overrides. Prefer PAPERCREATOR_WORKBENCH for new setups.
# PAPERCREATOR_HOME=D:\ResearchWorkbench\.papercreator
# PAPERCREATOR_WORKSPACE=D:\ResearchWorkbench\.papercreator\projects

# ---------------------------------------------------------------- server
PC_HOST=127.0.0.1
PC_PORT=8765
PC_LOG_LEVEL=INFO
# Comma-separated extra CORS origins. localhost/127.0.0.1 dev ports are
# always allowed; the Electron renderer uses the file:// origin.
# PC_CORS_EXTRA=

# ---------------------------------------------------------------- identity
# Sent as the User-Agent / mailto to scholarly APIs. Crossref + OpenAlex give
# better service to identified clients. Strongly recommended.
PC_CONTACT_EMAIL=

# ---------------------------------------------------- retrieval provider keys
# All of these are OPTIONAL. Providers that need a missing key report
# themselves as unavailable instead of failing the search.
# OpenAlex moved to a credit model: keyless works but with a small free daily
# allowance; a free key raises it ~10x.
PC_OPENALEX_API_KEY=
# Optional OpenAlex-compatible HTTPS mirror/proxy. Plain HTTP is rejected unless
# the host is localhost/127.0.0.1/::1 (useful for local development and tests).
PC_OPENALEX_ENDPOINT=https://api.openalex.org/works
# Semantic Scholar throttles keyless clients aggressively (HTTP 429).
PC_S2_API_KEY=
# NCBI E-utilities: 3 req/s keyless, 10 req/s with a key.
PC_NCBI_API_KEY=
PC_CORE_API_KEY=
PC_SPRINGER_API_KEY=
PC_IEEE_API_KEY=
PC_SCOPUS_API_KEY=

# ---------------------------------------------------------------- LLM keys
# Configure at least one to use the agent features. Can also be set at
# runtime in the UI (Settings > Models), which stores them in
# <workbench>/.papercreator/config/secrets.json (chmod 600 on POSIX).
PC_OPENAI_API_KEY=
PC_OPENAI_BASE_URL=https://api.openai.com/v1
PC_ANTHROPIC_API_KEY=
PC_ANTHROPIC_BASE_URL=https://api.anthropic.com
PC_GEMINI_API_KEY=
# PC_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
PC_DEEPSEEK_API_KEY=
# PC_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
PC_OPENROUTER_API_KEY=
# PC_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Local Ollama needs no key.
PC_OLLAMA_BASE_URL=http://127.0.0.1:11434
PC_OLLAMA_MODEL=

# --------------------------------------------------------------- analysis
# Optional Hugging Face mirror for sentence-transformer downloads.
# PC_HF_ENDPOINT=https://hf-mirror.com
# Never contact a model host; use only locally cached models and lexical fallbacks.
PC_OFFLINE_MODELS=0

# --------------------------------------------------------- desktop launcher
# Full interpreter path when Electron cannot find the intended Python.
# This is consumed by Electron, not the Python Settings model.
# PC_PYTHON=F:\AIWork\PaperCreator\.venv\Scripts\python.exe

# ---------------------------------------------------------------- overleaf
# Overleaf git bridge (paid Overleaf feature). Project URL looks like
# https://git.overleaf.com/<project-id>
PC_OVERLEAF_GIT_URL=
PC_OVERLEAF_GIT_TOKEN=
